# Пример файла переменных окружения.
# Скопируйте в .env и впишите свои ключи Bybit (demo-режим, виртуальные деньги).
# .env уже в .gitignore и не попадёт в git.
# ВАЖНО: .gitignore не защищает от OneDrive. Для проекта в синхронизируемой папке
# безопаснее задать системные переменные или хранить файл вне OneDrive и указать:
# BYBIT_ENV_FILE=C:\secure\bybit.env

BYBIT_API_KEY=
BYBIT_API_SECRET=

# Не обязательно: по умолчанию demo=True и DRY_RUN=True прописаны в trade_bot_macd.py
# BYBIT_DEMO_MODE=True
# BYBIT_DRY_RUN=True
